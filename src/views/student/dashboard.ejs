<%- include('../layouts/header', { title: 'Meu painel' }) %>
<%
  const _first = (user && user.full_name) ? firstName(user.full_name) : 'Estudante';
  const _mins = function (a) { return Math.max(1, Math.round((new Date(a.end) - new Date(a.start)) / 60000)); };
%>
<div class="lg:flex">
  <%- include('../layouts/sidebar', { active: 'home' }) %>
  <div class="flex-1 min-w-0">
    <%- include('../layouts/topbar', { heading: 'Olá, ' + _first + '!', sub: 'Seu ritmo de hoje também faz parte do aprendizado.' }) %>

    <main id="conteudo" class="p-6 lg:p-8 space-y-6">

      <!-- Meta do dia + timer -->
      <section class="rounded-2xl bg-languages-navy text-white p-6 lg:p-9 grid lg:grid-cols-[1fr_340px] gap-8 items-center" aria-labelledby="meta-t">
        <div>
          <h2 id="meta-t" class="text-2xl lg:text-3xl font-semibold leading-snug">Uma meta pequena para avançar com leveza</h2>
          <p class="mt-3 text-sm lg:text-base text-white/90 max-w-xl">Revise um resumo por 15 minutos. Se sobrar energia, faça o quiz — sem obrigação de terminar hoje.</p>
        </div>
        <div class="rounded-xl bg-white/10 border border-white/15 p-5" data-decor>
          <div class="flex items-center justify-between text-sm font-semibold"><span id="timer-l">Foco suave</span><span class="text-nature-amber"><%- icon('timer', 'w-5 h-5') %></span></div>
          <p id="timerDisplay" class="mt-2 text-5xl font-semibold tabular-nums" role="timer" aria-labelledby="timer-l">15:00</p>
          <button type="button" id="timerBtn" class="btn mt-4 w-full bg-white text-boutique-text hover:bg-slate-100"><%- icon('play', 'w-4 h-4') %><span>Iniciar timer</span></button>
          <p id="timerMsg" class="mt-2 text-xs text-white/85 min-h-[1rem]" aria-live="polite"></p>
        </div>
      </section>

      <!-- Preferências -->
      <section class="grid lg:grid-cols-[1fr_300px] gap-6" aria-label="Preferências de estudo" data-decor>
        <div class="card py-4 flex flex-wrap items-center gap-3">
          <span class="text-sm font-semibold" id="energy-l">Energia/foco:</span>
          <div class="flex flex-wrap gap-2" role="group" aria-labelledby="energy-l">
            <button type="button" class="chip min-h-[44px]" data-energy="Baixa" aria-pressed="true">Baixa</button>
            <button type="button" class="chip min-h-[44px]" data-energy="Média" aria-pressed="false">Média</button>
            <button type="button" class="chip min-h-[44px]" data-energy="Alta" aria-pressed="false">Alta</button>
          </div>
        </div>
        <div class="card py-4 flex items-center justify-between gap-4">
          <div><p id="clean-l" class="text-sm font-semibold">Leitura limpa</p><p class="text-xs text-slate-600">Menos elementos na tela</p></div>
          <button type="button" class="switch" role="switch" aria-checked="false" aria-labelledby="clean-l" data-clean-toggle></button>
        </div>
      </section>

      <div class="grid xl:grid-cols-[1fr_340px] gap-6 items-start">
        <div class="space-y-6 min-w-0">

          <!-- Próximas aulas -->
          <section id="agenda" class="card" aria-labelledby="aulas-t">
            <div class="flex flex-wrap items-start justify-between gap-3">
              <div><h2 id="aulas-t" class="text-xl font-semibold">Próximas aulas</h2><p class="text-xs text-slate-600 mt-1">Horários de Recife</p></div>
              <a href="/agendar" class="inline-flex items-center min-h-[44px] text-xs font-semibold underline">Solicitar nova aula</a>
            </div>
            <% if (appointments.length) { %>
              <ul class="mt-4 space-y-3">
                <% appointments.forEach(function (a) { const s = statusTheme(a.status); %>
                  <li class="rounded-xl bg-slate-50 p-4 flex items-center gap-4">
                    <div class="w-14 text-center shrink-0 leading-tight">
                      <p class="text-xs font-bold <%= a.status === 'CONFIRMED' ? 'text-nature-botanic' : 'text-[#8A6A14]' %>"><%= fmtDay(a.start).toUpperCase() %></p>
                      <p class="text-xs text-slate-600"><%= fmtTime(a.start) %></p>
                    </div>
                    <div class="min-w-0 grow">
                      <p class="text-sm font-semibold truncate"><%= a.areaName %> • Aula avaliativa</p>
                      <p class="text-xs text-slate-600"><%= _mins(a) %> minutos • <%= a.status === 'CONFIRMED' ? 'Confirmada pela professora' : 'Aguardando confirmação' %></p>
                    </div>
                    <span class="badge <%= s.cls %>"><%- icon(s.icon, 'w-3.5 h-3.5') %><%= s.label %></span>
                  </li>
                <% }) %>
              </ul>
            <% } else { %>
              <div class="mt-4 rounded-xl bg-slate-50 p-6 text-center">
                <p class="text-sm font-medium">Você ainda não tem aulas agendadas.</p>
                <a href="/agendar" class="btn-amber mt-4"><%- icon('calendar-check', 'w-5 h-5') %>Solicitar aula</a>
              </div>
            <% } %>
          </section>

          <!-- Materiais -->
          <section id="materiais" aria-labelledby="mat-t">
            <div class="flex flex-wrap items-end justify-between gap-3">
              <div><h2 id="mat-t" class="text-xl font-semibold">Materiais para seu momento</h2><p class="text-xs text-slate-600 mt-1">Os mais recentes publicados pela professora</p></div>
              <span class="badge bg-[#E8EDF4] text-languages-navy" data-decor><%- icon('sparkles', 'w-3.5 h-3.5') %><%= stats.totalMaterials %> <%= stats.totalMaterials === 1 ? 'material' : 'materiais' %></span>
            </div>
            <% if (materials.length) { %>
              <ul class="mt-4 grid md:grid-cols-2 xl:grid-cols-3 gap-4">
                <% materials.forEach(function (m) { const t = m.area ? areaTheme(m.area.code) : areaTheme(''); %>
                  <li>
                    <a href="/student/materials/<%= m.id %>" class="card p-5 h-full flex flex-col gap-3 hover:border-slate-400">
                      <span class="grid place-items-center w-10 h-10 rounded-lg <%= t.soft %> <%= t.text %>" data-decor><%- icon(t.icon, 'w-5 h-5') %></span>
                      <p class="text-[11px] font-bold uppercase tracking-wide <%= t.text %>"><%= m.area ? m.area.name : 'Material' %></p>
                      <p class="text-base font-medium leading-snug"><%= m.title %></p>
                      <% if (m.description) { %><p class="text-xs text-slate-600 line-clamp-2"><%= m.description %></p><% } %>
                      <p class="mt-auto pt-1 text-xs text-slate-600 flex items-center gap-1.5"><%- icon('file-text', 'w-3.5 h-3.5') %>PDF<%= m.target_student_id ? ' • só para você' : '' %></p>
                    </a>
                  </li>
                <% }) %>
              </ul>
            <% } else { %>
              <div class="card mt-4 text-center text-sm text-slate-600">Quando a professora publicar um material, ele aparecerá aqui.</div>
            <% } %>
          </section>
        </div>

        <aside class="space-y-6">
          <!-- Progresso real -->
          <section id="progresso" class="card" aria-labelledby="prog-t">
            <h2 id="prog-t" class="text-lg font-semibold">Meu progresso</h2>
            <dl class="mt-4 grid grid-cols-2 gap-3">
              <div class="rounded-xl bg-[#E8F0EB] p-4"><dd class="text-3xl font-semibold text-nature-botanic"><%= stats.confirmedCount %></dd><dt class="text-xs text-slate-700">aulas confirmadas</dt></div>
              <div class="rounded-xl bg-[#E8EDF4] p-4"><dd class="text-3xl font-semibold text-languages-navy"><%= stats.totalMaterials %></dd><dt class="text-xs text-slate-700">materiais para você</dt></div>
            </dl>
            <p class="mt-4 text-xs text-slate-600">Conquistas celebram consistência, não velocidade.</p>
            <a href="/student/submissions" class="btn-outline w-full mt-4"><%- icon('send', 'w-5 h-5') %>Enviar material para análise</a>
            <a href="/student/tutor" class="btn-green w-full mt-3"><%- icon('message', 'w-5 h-5') %>Tirar dúvida sobre os materiais</a>
          </section>

          <!-- Contato -->
          <section class="card" aria-labelledby="fale-t" data-decor>
            <h2 id="fale-t" class="text-lg font-semibold">Fale com a Prof.ª Rhuanna</h2>
            <p class="mt-3 text-sm text-slate-600">Dúvida, ajuste de aula ou material? Escolha o canal mais confortável.</p>
            <a href="<%= site.whatsappUrl %>" target="_blank" rel="noopener" class="btn-amber w-full mt-4"><%- icon('message', 'w-5 h-5') %>WhatsApp</a>
            <a href="mailto:<%= site.email %>" class="btn-outline w-full mt-3"><%- icon('mail', 'w-5 h-5') %>Enviar e-mail</a>
            <p class="mt-3 text-center text-xs text-slate-600">Resposta em até 1 dia útil</p>
          </section>

          <p class="hint bg-[#E8F0EB] text-boutique-text" data-decor><%- icon('lightbulb', 'w-4 h-4 mt-0.5 shrink-0 text-nature-botanic') %>Você pode pausar a qualquer momento. Sem pressa.</p>
        </aside>
      </div>
    </main>
  </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function () {
  var disp = document.getElementById('timerDisplay'), btn = document.getElementById('timerBtn'), msg = document.getElementById('timerMsg');
  var t = ST.makeTimer(15 * 60, function (s) {
    disp.textContent = ST.mmss(s);
    btn.querySelector('span').textContent = t.running ? 'Pausar' : (s < 15 * 60 ? 'Continuar' : 'Iniciar timer');
  }, function () { msg.textContent = 'Tempo concluído. Que tal uma pausa?'; });
  btn.addEventListener('click', function () { msg.textContent = ''; t.toggle(); });

  var chips = document.querySelectorAll('[data-energy]');
  try { var saved = localStorage.getItem('st-energy'); if (saved) chips.forEach(function (c) { c.setAttribute('aria-pressed', c.dataset.energy === saved ? 'true' : 'false'); }); } catch (_) {}
  chips.forEach(function (c) {
    c.addEventListener('click', function () {
      chips.forEach(function (x) { x.setAttribute('aria-pressed', x === c ? 'true' : 'false'); });
      try { localStorage.setItem('st-energy', c.dataset.energy); } catch (_) {}
    });
  });
});
</script>
<%- include('../layouts/end') %>
