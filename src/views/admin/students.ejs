<%- include('../layouts/header', { title: 'Alunos' }) %>
<%
  const _kpis = [
    { label: 'Alunos cadastrados', value: stats.total, icon: 'users', box: 'bg-[#E8EDF4] text-languages-navy' },
    { label: 'Com aula futura', value: stats.withUpcoming, icon: 'calendar-check', box: 'bg-[#E1EDE6] text-nature-botanic' },
    { label: 'Envios aguardando análise', value: stats.pendingSubmissions, icon: 'inbox', box: 'bg-[#F6EFD9] text-[#8A6A14]' }
  ];
%>
<div class="lg:flex">
  <%- include('../layouts/sidebar', { active: 'students' }) %>
  <div class="flex-1 min-w-0">
    <%- include('../layouts/topbar', { heading: 'Alunos', sub: 'Cadastros, responsáveis e atividade de aprendizagem' }) %>
    <main id="conteudo" class="p-6 lg:p-8 space-y-6">
      <section class="grid sm:grid-cols-3 gap-4" aria-label="Indicadores de alunos">
        <% _kpis.forEach(function (k) { %>
          <div class="card p-5">
            <div class="flex items-start justify-between gap-3">
              <p class="text-sm text-slate-600"><%= k.label %></p>
              <span class="grid place-items-center w-10 h-10 rounded-lg <%= k.box %>"><%- icon(k.icon, 'w-5 h-5') %></span>
            </div>
            <p class="mt-3 text-4xl font-semibold"><%= k.value %></p>
          </div>
        <% }) %>
      </section>

      <section class="card" aria-labelledby="student-list-title">
        <div class="flex flex-col sm:flex-row sm:items-end sm:justify-between gap-4">
          <div>
            <h2 id="student-list-title" class="text-xl font-semibold">Lista de alunos</h2>
            <p id="studentCount" class="mt-1 text-xs text-slate-600" aria-live="polite"></p>
          </div>
          <div class="w-full sm:max-w-sm">
            <label for="studentSearch" class="label">Buscar aluno</label>
            <input id="studentSearch" type="search" class="input" placeholder="Nome ou e-mail">
          </div>
        </div>

        <% if (students.length) { %>
          <div class="mt-5 overflow-x-auto">
            <table class="w-full min-w-[850px] text-sm">
              <thead class="bg-slate-50">
                <tr>
                  <th scope="col" class="th">Aluno</th>
                  <th scope="col" class="th">Responsável</th>
                  <th scope="col" class="th">Atividade</th>
                  <th scope="col" class="th">Última solicitação</th>
                  <th scope="col" class="th">Contato</th>
                </tr>
              </thead>
              <tbody>
                <% students.forEach(function (student) { %>
                  <%
                    const searchText = [student.name, student.email, student.guardian_name, student.guardian_phone]
                      .filter(Boolean).join(' ').toLowerCase();
                    const guardianPhone = String(student.guardian_phone || student.phone || '').replace(/\D/g, '');
                  %>
                  <tr class="student-row border-b border-slate-100 align-top" data-search="<%= searchText %>">
                    <td class="px-3 py-4">
                      <p class="font-semibold"><%= student.name %></p>
                      <p class="mt-1 text-xs text-slate-600"><%= student.email %></p>
                    </td>
                    <td class="px-3 py-4">
                      <% if (student.guardian_name) { %>
                        <p class="font-medium"><%= student.guardian_name %></p>
                        <p class="mt-1 text-xs text-slate-600"><%= student.guardian_relationship || 'Responsável' %></p>
                        <% if (student.guardian_phone) { %><p class="mt-1 text-xs text-slate-600"><%= student.guardian_phone %></p><% } %>
                      <% } else { %>
                        <p class="text-xs text-slate-500">Contato não informado</p>
                      <% } %>
                    </td>
                    <td class="px-3 py-4">
                      <p><%= student.appointmentCount %> <%= student.appointmentCount === 1 ? 'aula' : 'aulas' %></p>
                      <p class="mt-1 text-xs text-slate-600"><%= student.materialCount %> materiais disponíveis</p>
                      <% if (student.pendingSubmissions) { %>
                        <p class="mt-1 text-xs font-semibold text-[#7A5C10]"><%= student.pendingSubmissions %> envio(s) pendente(s)</p>
                      <% } %>
                    </td>
                    <td class="px-3 py-4">
                      <% if (student.lastAppointment) { %>
                        <p><%= fmtDayYear(student.lastAppointment.start_time) %> • <%= fmtTime(student.lastAppointment.start_time) %></p>
                        <span class="badge mt-1 <%= statusTheme(student.lastAppointment.status).cls %>"><%= statusTheme(student.lastAppointment.status).label %></span>
                      <% } else { %>
                        <span class="text-xs text-slate-500">Nenhuma solicitação</span>
                      <% } %>
                    </td>
                    <td class="px-3 py-4">
                      <div class="flex flex-wrap gap-2">
                        <a class="btn-icon" href="mailto:<%= encodeURIComponent(student.email) %>" aria-label="Enviar e-mail para <%= student.name %>"><%- icon('mail', 'w-4 h-4') %></a>
                        <% if (guardianPhone) { %>
                          <a class="btn-icon" href="https://wa.me/<%= guardianPhone.length <= 11 ? '55' + guardianPhone : guardianPhone %>" target="_blank" rel="noopener" aria-label="Abrir WhatsApp do responsável de <%= student.name %>"><%- icon('message', 'w-4 h-4') %></a>
                        <% } %>
                      </div>
                    </td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
            <p id="studentNoResults" class="mt-4 rounded-xl bg-slate-50 p-5 text-center text-sm text-slate-600" hidden>Nenhum aluno corresponde à busca.</p>
          </div>
        <% } else { %>
          <div class="mt-5 rounded-xl bg-slate-50 p-6 text-center">
            <h3 class="font-semibold">Ainda não há alunos cadastrados</h3>
            <p class="mt-2 text-sm text-slate-600">Quando um aluno concluir o cadastro no Habitat, ele aparecerá nesta lista.</p>
          </div>
        <% } %>
      </section>

      <nav class="flex flex-wrap gap-3" aria-label="Atalhos de gestão">
        <a href="/admin/appointments" class="btn-outline"><%- icon('calendar', 'w-4 h-4') %>Ver agendamentos</a>
        <a href="/admin/materials" class="btn-outline"><%- icon('library', 'w-4 h-4') %>Gerenciar materiais</a>
        <a href="/admin/submissions" class="btn-outline"><%- icon('inbox', 'w-4 h-4') %>Analisar envios</a>
      </nav>
    </main>
  </div>
</div>
<script>
document.addEventListener('DOMContentLoaded', function () {
  var input = document.getElementById('studentSearch');
  var rows = Array.prototype.slice.call(document.querySelectorAll('.student-row'));
  var count = document.getElementById('studentCount');
  var empty = document.getElementById('studentNoResults');

  function filterStudents() {
    var query = input.value.trim().toLocaleLowerCase('pt-BR');
    var visible = 0;
    rows.forEach(function (row) {
      var matches = row.dataset.search.includes(query);
      row.hidden = !matches;
      if (matches) visible += 1;
    });
    count.textContent = visible + (visible === 1 ? ' aluno' : ' alunos');
    if (empty) empty.hidden = visible !== 0;
  }

  input.addEventListener('input', filterStudents);
  filterStudents();
});
</script>
<%- include('../layouts/end') %>
